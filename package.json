{
  "name": "pi-roles",
  "version": "0.1.0",
  "description": "Multi-roles for pi agent — spawn_role with persona/tool-whitelist/per-role skill isolation (via resources_discover), plus subagent control plane (step limit / liveness / output contract / failure passing / depth limit). Builds on @gotgenes/pi-subagents service. Upgrade path to team (chatroom mailbox) reserved.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "roles",
    "schemas",
    "multi-agent",
    "subagent",
    "spawn-role",
    "handoff"
  ],
  "license": "MIT",
  "author": "SilentMoebuta",
  "files": [
    "index.ts",
    "src",
    "roles",
    "schemas",
    "__tests__",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.ts",
    "./role-result": "./src/role-result.ts",
    "./schemas/*": "./schemas/*"
  },
  "pi": {
    "extensions": [
      "./"
    ]
  },
  "scripts": {
    "test": "tsx --test __tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@types/node": "^22.19.21",
    "tsx": "^4.0.0",
    "typebox": "1.1.38",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1"
  }
}
