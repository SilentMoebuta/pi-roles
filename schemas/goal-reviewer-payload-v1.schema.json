{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentmoebuta.github.io/pi-roles/schemas/goal-reviewer-payload-v1.schema.json",
  "title": "PI Goal Reviewer Payload V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary", "criterionCoverage", "findings", "artifacts"],
  "properties": {
    "decision": { "enum": ["accept", "revise", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "criterionCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "status", "evidenceIds"],
        "properties": {
          "criterionId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["satisfied", "unsatisfied", "blocked"] },
          "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "severity", "subjectId", "reason", "evidenceRefs", "missingEvidenceKind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "minLength": 1 },
          "subjectId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "missingEvidenceKind": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "digest", "sizeBytes"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "advisories": { "type": "array", "items": { "type": "string" } }
  }
}
