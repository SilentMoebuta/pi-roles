{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentmoebuta.github.io/pi-roles/schemas/batch-result-v1.schema.json",
  "title": "PI Batch Aggregate Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchId", "status", "total", "completed", "failed", "cancelled", "results"],
  "properties": {
    "batchId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "partial", "failed"] },
    "total": { "type": "integer", "minimum": 0 },
    "completed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "cancelled": { "type": "integer", "minimum": 0 },
    "results": { "type": "array", "items": { "$ref": "#/$defs/result" } }
  },
  "$defs": {
    "result": { "type": "object", "additionalProperties": false, "required": ["taskId", "runId", "attemptId", "status"], "properties": { "taskId": { "type": "string", "minLength": 1 }, "runId": { "type": "string", "minLength": 1 }, "attemptId": { "type": "string", "minLength": 1 }, "status": { "enum": ["completed", "failed", "cancelled"] }, "value": {}, "error": { "type": "object", "required": ["code", "message", "retryable"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "retryable": { "type": "boolean" } }, "additionalProperties": false } } }
  }
}
