{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentmoebuta.github.io/pi-roles/schemas/profile-layer-v1.schema.json",
  "title": "PI Profile Layer V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "scope", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["organization", "user", "repository"] },
    "components": { "$ref": "#/$defs/components" },
    "enforced": { "$ref": "#/$defs/components" }
  },
  "$defs": {
    "components": { "type": "object", "additionalProperties": false, "properties": { "profile": { "type": "object" }, "skills": { "type": "object" }, "mcp": { "type": "object" }, "hooks": { "type": "object" }, "projectPolicy": { "type": "object" } } }
  }
}
